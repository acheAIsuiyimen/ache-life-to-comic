{
  "schemaVersion": "ache-design-system/1.3.0",
  "id": "ache-comic-journal-white-1",
  "source": {
    "canonicalHandbook": "漫画人生-喜茶近三月插画排版手册-v0.1/设计排版手册.md",
    "policy": "reuse-before-invent",
    "note": "这是生成、排版与验收的唯一基础口径；新增样式只能作为有版本的扩展。"
  },
  "canvas": {
    "widthPx": 1080,
    "heightPx": 1440,
    "aspectRatio": "3:4",
    "background": "#FFFFFF",
    "whiteAreaRatio": [0.7, 0.85],
    "safeMarginRatio": 0.05,
    "paperTextureOpacity": [0.02, 0.06],
    "beigeOrKraftAllowedOnlyWhenSemantic": true
  },
  "color": {
    "inkAreaRatio": [0.08, 0.15],
    "contentColorAreaRatio": [0.05, 0.15],
    "contentColorCount": 1,
    "forbiddenPageGrounds": [
      "#F5E6C8",
      "#F1DFC0",
      "#EAD4A8",
      "beige",
      "kraft",
      "parchment",
      "warm yellow paper"
    ]
  },
  "typography": {
    "fontRoleCountMax": 3,
    "display": {
      "role": "chapter-title",
      "familyToken": "editorial-cjk-display",
      "maxCjk": 14,
      "mayUseHandDrawnAccent": true
    },
    "body": {
      "role": "facts-and-long-reading",
      "familyToken": "readable-cjk-serif-or-sans",
      "handwritingForbidden": true,
      "minPxAt1080": 28,
      "lineHeight": [1.55, 1.8]
    },
    "note": {
      "role": "emotion-and-margin-note",
      "familyToken": "handwriting-like-cjk",
      "maxCjkPerNote": 22,
      "maxBrushStylesPerPage": 2
    },
    "generatedImageText": "forbidden"
  },
  "pageZones": {
    "titleAndDateRatio": [0.06, 0.1],
    "mainVisualRatio": [0.28, 0.58],
    "narrationAndEvidenceRatio": [0.12, 0.22],
    "footerAndSourceRatio": [0.03, 0.06],
    "whitespaceRatio": [0.4, 0.65],
    "factRatioMax": 0.18,
    "materialGroupCount": [0, 2]
  },
  "templates": {
    "A-white-object-theatre": {
      "name": "白纸物件剧场",
      "defaultRoutes": ["S"],
      "useWhen": ["no-photo", "one-symbolic-object", "single-emotional-turn"]
    },
    "B-photo-window": {
      "name": "照片异形窗口",
      "defaultRoutes": ["P"],
      "useWhen": ["one-to-five-photos", "preserve-complete-photo"]
    },
    "C-handwritten-archive": {
      "name": "手写档案页",
      "defaultRoutes": ["K", "M", "L"],
      "useWhen": ["text-first", "facts-or-notes", "few-supporting-illustrations"]
    },
    "D-single-object-totem": {
      "name": "单物图腾",
      "defaultRoutes": ["cover", "ending"],
      "useWhen": ["one-memory-object", "chapter-title-needs-icon"]
    },
    "E-continuous-action": {
      "name": "连续动作漫画",
      "defaultRoutes": ["S"],
      "useWhen": ["two-or-more-real-beats", "state-change", "before-after"]
    }
  },
  "implementation": {
    "renderer": "scripts/page-renderer.mjs",
    "stylesheet": "assets/templates/page-system.css",
    "contract": "Platforms supply content and textless visuals; the deterministic renderer owns page ratio, type roles, spacing, image fitting, page boundaries and responsive behavior.",
    "freehandPlatformHtmlForbidden": true,
    "normalFlowForPrimaryZones": true,
    "absolutePositioningForTextForbidden": true,
    "precomposedPageMustNotBeReframed": true,
    "imageCropRequiresExplicitOptIn": true
  },
  "routing": {
    "routeContracts": {
      "S": {
        "cover": "one-real-moment-or-emotion",
        "body": "one-to-three-top-to-bottom-comic-panels",
        "preserve": "source-beat-order"
      },
      "P": {
        "cover": "independent-semantic-recomposition",
        "body": "complete-original-photos-in-journal-layout",
        "preserve": "original-photo-bytes-and-complete-visible-frame"
      },
      "K": {
        "cover": "one-core-process-or-relation",
        "body": "readable-text-with-sparse-explanatory-visual",
        "preserve": "facts-and-source-traceability"
      },
      "M": {
        "cover": "topic-decision-tension-or-next-action",
        "body": "structured-notes-with-light-illustration",
        "preserve": "speakers-decisions-risks-open-questions-and-tasks"
      },
      "L": {
        "cover": "single-metaphor-from-the-whole-text",
        "body": "exact-longform-reading-with-margin-illustration",
        "preserve": "exact-text-paragraphs-and-order"
      }
    },
    "photoCount": {
      "1": "B-photo-window",
      "2": "B-photo-window-main-plus-echo",
      "3": "B-photo-window-vertical-relay-only-when-time-or-view-changes",
      "4-5": "B-photo-window-main-plus-evidence-strip",
      "6-9": "B-photo-window-two-or-three-pages",
      "10+": "group-before-layout"
    },
    "cooldown": {
      "sameSkeletonMaxConsecutivePages": 2,
      "sameMaterialMaxConsecutivePages": 1,
      "consecutiveWhitePagesMustMoveMainVisual": true
    },
    "multiPanel": {
      "equalColumnsForbiddenByDefault": true,
      "largestPanelRatio": [0.45, 0.6],
      "readingDirection": "top-to-bottom",
      "triangleStackForbidden": true
    }
  },
  "quality": {
    "oneVisualSurprisePerPage": true,
    "approvedCaseAlignment": {
      "sameLayoutRequired": false,
      "mustPreserve": [
        "white-ground-and-restrained-materials",
        "title-to-visual-relationship",
        "one-meaningful-visual-surprise",
        "route-specific-editorial-rhythm"
      ],
      "rejectIfTechnicallyCorrectButGeneric": true
    },
    "blockingGeometryChecks": [
      "header-content-footer-collision",
      "text-image-collision",
      "page-scroll-overflow",
      "image-fit-and-visible-ratio",
      "mobile-font-size",
      "title-orphan-line",
      "four-band-density",
      "unexplained-bottom-empty-band",
      "asset-lineage-and-subject-integrity",
      "monthly-cover-exists"
    ],
    "measuredCorrectionLadder": {
      "1-40px": "nudge-local-spacing",
      "41-90px": "compact-local-zone",
      "91-160px": "adjust-title-or-paragraph-rhythm",
      "161px+": "switch-layout-recipe-or-paginate",
      "bodyTextShrinkAsFirstFix": false
    },
    "activeCompositionRatioMin": 0.75,
    "forbiddenLooks": [
      "presentation-slide",
      "product-ui-card",
      "children-homework",
      "sticker-pile",
      "yellow-beige-full-page-ground",
      "generic-blog-column",
      "full-width-image-stack",
      "unstyled-meeting-paragraph"
    ],
    "requiredViewports": [
      "1080x1440",
      "135x180",
      "desktop-1440",
      "mobile-390"
    ]
  }
}
